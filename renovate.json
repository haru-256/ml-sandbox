{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["every 2 weeks on monday"],
  "minimumReleaseAge": "14 days",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  },
  "packageRules": [
    {
      "matchPaths": ["projects/[^/]+/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "{{{parentDir}}} minor dependencies",
      "automerge": false
    },
    {
      "matchPaths": ["projects/[^/]+/**"],
      "matchUpdateTypes": ["major"],
      "groupName": "{{{parentDir}}} major dependencies",
      "automerge": false
    },
    {
      "matchPaths": ["libs/[^/]+/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "{{{parentDir}}} minor dependencies",
      "automerge": false
    },
    {
      "matchPaths": ["libs/[^/]+/**"],
      "matchUpdateTypes": ["major"],
      "groupName": "{{{parentDir}}} major dependencies",
      "automerge": false
    },
    {
      "matchPaths": ["apps/[^/]+/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "{{{parentDir}}} minor dependencies",
      "automerge": false
    },
    {
      "matchPaths": ["apps/[^/]+/**"],
      "matchUpdateTypes": ["major"],
      "groupName": "{{{parentDir}}} major dependencies",
      "automerge": false
    }
  ]
}
