{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "automerge": true,
      "minimumReleaseAge": "14 days"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
